# Django
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_NAME=Tochka dizayna i pechati
SITE_URL=http://127.0.0.1:8000

# Email notifications
# For mail.ru use SMTP over SSL on port 465.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_HOST_USER=your-mailru-login@mail.ru
EMAIL_HOST_PASSWORD=your-mailru-app-password
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=your-mailru-login@mail.ru
SERVER_EMAIL=your-mailru-login@mail.ru
APPLICATION_NOTIFICATION_EMAIL=orders@example.com

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Note:
# The project uses SQLite from config/settings.py by default
# and does not require database env vars in the current setup.
